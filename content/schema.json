{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ch",
    "openstax_section",
    "guide_line",
    "steps",
    "worked_example",
    "similar_problem",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "openstax_section": {
      "type": "string",
      "minLength": 1
    },
    "guide_line": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worked_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "answer"
      ],
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "similar_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "hint",
        "answer"
      ],
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "q",
        "a",
        "why",
        "hints",
        "check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "q": {
          "type": "string",
          "minLength": 1
        },
        "a": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check": {
          "$ref": "#/$defs/check"
        },
        "guided": {
          "type": "array",
          "description": "Optional worked steps (lane B).",
          "items": {
            "type": "object",
            "required": [
              "prompt",
              "answer"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "mistakes": {
          "type": "array",
          "description": "Optional common mistakes for diagnosis (lane B).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "describe"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "describe": {
                "type": "string",
                "minLength": 1
              },
              "wrong": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "numeric",
            "exact",
            "set",
            "config"
          ]
        },
        "value": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Relative percent. 0.5 means 0.5% of the expected value. Default 0.5 when omitted."
        },
        "sigFigs": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "case": {
          "enum": [
            "insensitive",
            "sensitive",
            "formula"
          ],
          "description": "Omitted means formula: element symbols stay case-sensitive. Use insensitive for element names and ordinary words."
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nearMiss": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hint": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
