{
  "id": "ch6-solutions",
  "ch": 6,
  "openstax_section": "OpenStax AF2e §6.4",
  "guide_line": "Find mass percent, ppm, and ppb.",
  "steps": [
    "Mass percent = (grams solute / grams solution) × 100. The solution includes the solute.",
    "Mass/volume percent = (grams solute / mL solution) × 100.",
    "ppm = (grams solute / grams sample) × 10^6. For dilute water, 1 ppm ≈ 1 mg/L.",
    "ppb = (grams solute / grams sample) × 10^9.",
    "Type the number only."
  ],
  "worked_example": {
    "q": "5.00 g of solute in 100. g of solution. Mass percent?",
    "steps": [
      "5.00 / 100. × 100 = 5.00%."
    ],
    "answer": "5.00%"
  },
  "similar_problem": {
    "q": "10.0 g NaCl dissolved in 90.0 g water. Mass percent?",
    "hint": "The solution mass is 10.0 + 90.0.",
    "answer": "10.0%"
  },
