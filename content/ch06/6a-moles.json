{
  "id": "ch6-moles",
  "ch": 6,
  "openstax_section": "OpenStax AF2e §6.1",
  "guide_line": "Convert grams, moles, and particles.",
  "steps": [
    "Molar mass is each atomic mass times its subscript, then added. A subscript outside parentheses multiplies the whole group.",
    "Use the OpenStax masses to hundredths: H 1.008, C 12.01, N 14.01, O 16.00, Na 22.99, Cl 35.45, Ca 40.08.",
    "Grams to moles: divide by the molar mass. Moles to grams: multiply.",
    "Particles = moles × 6.022×10²³. Moles = particles ÷ 6.022×10²³.",
    "Type the number only."
  ],
  "worked_example": {
    "q": "Molar mass of H2O?",
    "steps": [
      "2(1.008) + 16.00 = 18.02 g/mol."
    ],
    "answer": "18.02 g/mol"
  },
  "similar_problem": {
    "q": "How many moles are in 36.0 g of water?",
    "hint": "Divide by 18.02 g/mol.",
    "answer": "2.00 mol"
  },
  "sources": [
