{
  "id": "ch6-molarity",
  "ch": 6,
  "openstax_section": "OpenStax AF2e §6.3",
  "guide_line": "Find molarity, or the grams that make a solution.",
  "steps": [
    "Molarity = moles of solute / liters of solution.",
    "Change mL to L before you divide or multiply.",
    "Grams to moles: divide by the molar mass. Moles to grams: multiply.",
    "n = M × V, with V in liters.",
    "Type the number only."
  ],
  "worked_example": {
    "q": "5.85 g NaCl makes 500. mL of solution. Molarity?",
    "steps": [
      "5.85 / 58.44 = 0.100 mol.",
      "0.500 L.",
      "0.100 / 0.500 = 0.200 M."
    ],
    "answer": "0.200 M"
  },
  "similar_problem": {
    "q": "10.0 g NaOH makes 250. mL of solution. Molarity?",
    "hint": "NaOH is 40.00 g/mol. Volume is 0.250 L.",
    "answer": "1.00 M"
  },
