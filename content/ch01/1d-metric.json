  "id": "ch1-metric",
  "ch": 1,
  "openstax_section": "OpenStax AF2e §1.4",
  "guide_line": "Convert metric units with a factor that cancels.",
  "steps": [
    "Write the starting number with its unit.",
    "Multiply by a fraction equal to 1 so the old unit cancels.",
    "k means 10³, c means 10⁻², m means 10⁻³, µ means 10⁻⁶, n means 10⁻⁹, and G means 10⁹.",
    "If you convert to a smaller unit, the number gets bigger. If you convert to a bigger unit, the number gets smaller."
  ],
  "worked_example": {
    "q": "Convert 2.5 km to m.",
    "steps": [
      "1 km = 1000 m.",
      "2.5 km × 1000 m/km = 2500 m."
    ],
    "answer": "2500 m"
  },
  "similar_problem": {
    "q": "Convert 450 mg to g.",
    "hint": "1 mg = 0.001 g. The number should get smaller.",
    "answer": "0.45 g"
  },
