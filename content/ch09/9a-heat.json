  "openstax_section": "OpenStax AF2e §9.2",
  "guide_line": "Use q = mcΔT, and switch joules and calories.",
  "steps": [
    "q = m c ΔT. ΔT is final minus initial.",
    "Water’s specific heat is 4.184 J/g·°C.",
    "A temperature drop makes q negative. The system lost heat.",
    "1 cal = 4.184 J. 1 Cal (food) = 1 kcal = 4184 J.",
    "Type the number only. Include a minus sign when heat is lost."
  ],
  "worked_example": {
    "q": "Heat to warm 50.0 g water from 20.0 to 45.0 °C?",
    "steps": [
      "ΔT = 25.0.",
      "q = 50.0 × 4.184 × 25.0 = 5230 J."
    ],
    "answer": "5230 J"
  },
  "similar_problem": {
