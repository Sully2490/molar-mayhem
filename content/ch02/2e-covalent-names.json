{
  "id": "ch2-covalent-names",
  "ch": 2,
  "openstax_section": "OpenStax AF2e §2.7",
  "guide_line": "Name a covalent compound with prefixes.",
  "steps": [
    "Use prefixes: mono, di, tri, tetra, penta, hexa, hepta, octa, nona, deca.",
    "Skip mono- on the first element.",
    "The second element ends in -ide.",
    "Do not use these prefixes on ionic compounds."
  ],
  "worked_example": {
    "q": "Name N2O5.",
    "steps": [
      "Two nitrogen atoms: dinitrogen.",
      "Five oxygen atoms: pentoxide."
    ],
    "answer": "dinitrogen pentoxide"
  },
  "similar_problem": {
    "q": "Name CO.",
    "hint": "Skip mono- on carbon. Keep it on oxygen.",
    "answer": "carbon monoxide"
  },
  "sources": [
    "OpenStax AF2e §2.7"
  ],
